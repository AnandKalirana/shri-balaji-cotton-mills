# Database (Supabase: Connect > Session pooler, port 5432)
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Login security. REQUIRED in production. Use a random string of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# First admin account, created by `npx prisma db seed` (password: 12+ characters).
# Nothing is hard-coded: if these are not set, no admin is created.
ADMIN_EMAIL="owner@yourdomain.in"
ADMIN_PASSWORD=""

# Razorpay (dashboard.razorpay.com > Settings > API Keys). Use rzp_test_ keys until you go live.
# Without them, online payment is switched off and customers can only choose Cash on Delivery.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret: Razorpay dashboard > Settings > Webhooks. URL: https://YOUR-DOMAIN/api/payment/webhook, events: payment.captured and order.paid.
# Makes sure a customer who pays and then closes the tab still gets their order.
RAZORPAY_WEBHOOK_SECRET=""

# Supabase Storage for product and banner photos (server-side only, never expose the key)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-secret-key"
SUPABASE_STORAGE_BUCKET="product-images"

# Order emails (optional). Any SMTP service works: Gmail (app password), Brevo, Zoho, Resend SMTP.
# Without these the store works but sends no emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Shown as the sender, e.g. Shri Balaji Cotton Mills <orders@yourdomain.in>
MAIL_FROM=""
# Where new-order alerts go. Defaults to the support email in Admin > Settings.
ORDER_ALERT_EMAIL=""
